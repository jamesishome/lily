(rule
 (target term.ml)
 (deps ../examples/term.li)
 (action
  (run %{bin:lily} compile %{deps} -o %{target})))

(rule
 (target block.ml)
 (deps ../examples/block.li)
 (action
  (run %{bin:lily} compile %{deps} -o %{target})))

(library
 (name model)
 (modules model)
 (flags
  (:standard -w -a)))

(tests
 (names test agree)
 (modules term block test agree)
 (libraries bind model))

(cram
 (deps
  %{bin:lily}
  (glob_files ../examples/*.li)
  ../runtime/bind.ml
  ../examples/probe.ml
  ../examples/probe.sh))
